.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
credentials/

# секреты и приватные данные — НИКОГДА в git (репозиторий публичный)
credentials.json
hub-api/private.json
hub-api/config.json
server/scripts/*.cjs

# не публиковать в открытый репозиторий
CLAUDE.md
AGENTS.md
.claude/

# скриншоты и логи проверок в корне — рабочий мусор, в git им не место
/*.png
/*.jpg
/*.log
/*.pdf
.playwright-mcp/

# локальные QA-профили, сборки и временные файлы
.audit-*/
.chrome-*/
tmp/
pc-app/dist/
pc-app/tmp/
pc-app/sync/__pycache__/
dist-mobile-*/
*.noda-part-*

# Личные референс-фото для генерации стикеров (не коммитим)
stickers/
